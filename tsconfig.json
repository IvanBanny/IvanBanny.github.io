{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "noEmit": true,
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"]
    },
    "include": ["app.js", "src/*.js"]
}
